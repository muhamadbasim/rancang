# Rancang environment variables
# The app works fully offline with no configuration. These are OPTIONAL and only
# needed if you want to enrich blueprint phrasing with an LLM provider.

# Set to "1" to attempt LLM enrichment (falls back to the offline engine on any error).
RANCANG_USE_LLM=0

# OpenAI-compatible endpoint (optional)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
